# =============================================================================
# TutorIA Backend — Environment Variables
# =============================================================================
# Copy this file to .env and adjust values for your environment.
# NEVER commit the .env file to version control.

# -- LLM (Ollama, OpenAI-compatible interface) --------------------------------
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# -- Database (unified PostgreSQL + pgvector) ---------------------------------
# Matches the postgres service in docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://tutoria:tutoria@localhost:5432/tutoria

# -- Application ---------------------------------------------------------------
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=["http://localhost","http://localhost:18000"]

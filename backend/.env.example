# =============================================================================
# TutorIA Backend — Environment Variables
# =============================================================================
# Copy this file to .env and adjust values for your environment.
# NEVER commit the .env file to version control.

# -- LLM (Ollama, OpenAI-compatible interface) --------------------------------
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# -- Claude API (FUTURE USE — inert today, see RF-23) -------------------------
# Placeholders so that enabling Claude later is a config change, not a code
# change. Leave CLAUDE_API_KEY empty and USE_CLASSIFIER false for now.
# CLAUDE_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022
USE_CLASSIFIER=false

# -- Database (unified PostgreSQL + pgvector) ---------------------------------
# Matches the postgres service in docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://tutoria:tutoria@localhost:5432/tutoria

# -- Embeddings / RAG (Ollama native API) -------------------------------------
# Ollama runs as a docker-compose service; the model is pulled by ollama-init.
# Inside the docker network, reach Ollama by its service name:
OLLAMA_BASE_URL=http://ollama:11434
# When running the backend OUTSIDE docker (uvicorn on the host), use instead:
#   OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_TIMEOUT=30.0
# Set true in production to refuse startup when the embedding model is missing.
REQUIRE_EMBEDDING_MODEL=false

# -- Application ---------------------------------------------------------------
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=["http://localhost","http://localhost:18000"]

# =============================================================================
# TutorIA Backend — Environment Variables
# =============================================================================
# Copy this file to .env and adjust values for your environment.
# NEVER commit the .env file to version control.

# -- LLM (Ollama) -------------------------------------------------------------
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# -- Database ------------------------------------------------------------------
# SQLite (development):
DATABASE_URL=sqlite+aiosqlite:///./tutoria.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/tutoria

# -- ChromaDB (RAG) -----------------------------------------------------------
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=tutoria_modules

# -- Application ---------------------------------------------------------------
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=["http://localhost","http://localhost:18000"]

# =============================================================================
# TutorIA Backend — Environment Variables
# =============================================================================
# Copy this file to .env and adjust values for your environment.
# NEVER commit the .env file to version control.

# -- LLM (Ollama, OpenAI-compatible interface) --------------------------------
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# -- Database (unified PostgreSQL + pgvector) ---------------------------------
# Matches the postgres service in docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://tutoria:tutoria@localhost:5432/tutoria

# -- Embeddings / RAG (Ollama native API) -------------------------------------
# Ollama's /api/embeddings lives at the native base URL (no /v1 suffix).
# Pull the model first:  ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_TIMEOUT=30.0
# Set true in production to refuse startup when the embedding model is missing.
REQUIRE_EMBEDDING_MODEL=false

# -- Application ---------------------------------------------------------------
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=["http://localhost","http://localhost:18000"]
